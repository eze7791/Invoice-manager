{
  "name": "facturacion",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace api & npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "deploy": "npm run build && npm run deploy --workspace api",
    "db:up": "docker compose up -d db",
    "db:generate": "npm run db:generate --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "create-user": "npm run create-user --workspace api --",
    "test": "npm run test --workspace api",
    "typecheck": "npm run typecheck --workspaces"
  }
}
